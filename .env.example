APP_NAME="RAG Support MVP"
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/rag_support"

# Embedding provider: local only in this MVP
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# LLM provider: ollama or openai
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

CHUNK_SIZE=900
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
